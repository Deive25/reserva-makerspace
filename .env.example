POSTGRES_DB=makerspace
POSTGRES_USER=makerspace
POSTGRES_PASSWORD=

# Chave que assina os tokens de login (JWT). Obrigatória, com pelo menos 32 caracteres.
# Gere uma com: openssl rand -base64 48
JWT_CHAVE=

# Primeira Coordenação: criada na subida se ainda não existir nenhuma Coordenação.
# Use um e-mail que ninguém tenha cadastrado e uma senha de 15 caracteres ou mais.
COORDENACAO_EMAIL=
COORDENACAO_SENHA=

# Dados de exemplo: tipos, máquinas e uma pessoa em cada papel (aluna@, bolsista@ e coordenadora@makerspace.example).
# A senha, de 15 caracteres ou mais, vale para as três pessoas. Sem ela, entram só os tipos e as máquinas.
EXEMPLO_SENHA=
